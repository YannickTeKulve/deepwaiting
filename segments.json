          "text": "Hello, World.",
          "start": 305.121,
          "end": 307.101
        },
        {
          "text": "But now...",
          "start": 308.188,
          "end": 308.561
        },
        {
          "text": "It does so with enterprise-grade observability.",
          "start": 309.041,
          "end": 313.041
        },
        {
          "text": "Distributed tracing.",
          "start": 313.414,
          "end": 315.841
