          "end": 202
        },
        {
          "text": "Breathe in.",
          "start": 202.92,
          "end": 203.521
        },
        {
          "text": "Breathe out.",
          "start": 205.24,
          "end": 207
        },
        {
          "text": "Notice the beautiful abstraction.",
