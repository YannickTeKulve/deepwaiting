          "end": 225.28
        },
        {
          "text": "Two adapters.",
          "start": 226.06,
          "end": 227.88
        },
        {
          "text": "A builder.",
          "start": 228.8,
          "end": 230
        },
        {
          "text": "A registry.",
          "start": 230.72,
          "end": 232.16
